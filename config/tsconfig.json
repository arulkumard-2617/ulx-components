{
	"extends": "@tsconfig/ember/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"declarationDir": "../dist",
		"declarationMap": true,
		"declaration": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": false,
		"outDir": "../dist",
		"paths": {
			"ulx-components": ["../src/index.js"],
			"ulx-components/*": ["../src/*"]
		},
		"rootDir": "../src",
		"target": "esnext"
	},
	"include": ["../src/**/*"],
	"exclude": ["../node_modules", "../dist", "**/*.gjs", "**/*.gts"]
}
