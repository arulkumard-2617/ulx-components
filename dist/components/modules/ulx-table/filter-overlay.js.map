						@options={{this.operatorOptions}}
						@optionLabel="label"
						@optionValue="value"
						@onChange={{this.setOperator}}
						aria-label={{t "aria.table.filter.operator"}}
					/>
				</div>
			{{/if}}

			<div class="filter-constraints">
				{{#each this.constraints key="@index" as |constraint index|}}
