	"description": "Ember addon v2 with .gjs components",
	"keywords": [
		"ember-addon"
	],
	"license": "MIT",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*",
		"./addon-main.js": "./config/addon-main.cjs"
	},
	"files": [
		"dist",
		"src",
		"styles",
		"config",
		"dev-releases",
