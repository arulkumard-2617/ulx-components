    "ulsBuild:css": "vite build -c vite.config.build.mjs -m less",
    "ulsBuild:css:core": "vite build -c vite.config.build.mjs -m less-only",
    "ulsBuild:js": "vite build -c vite.config.build.mjs -m js",
    "ulsDev:watch": "uls-watch-less",
    "ulsDev:watch:vite": "vite build -c vite.config.build.mjs -m less -w",
    "dev": "npm run ulsDev:watch",
    "create": "node node_modules/uls-v2/src/scripts/create-uls-app.js",
    "ulsBuild:guls": "ULS_APP=guls npm run ulsBuild",
    "ulsDev:guls": "ULS_APP=guls npm run ulsDev:watch",
