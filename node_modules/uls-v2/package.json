{
  "name": "uls-v2",
  "version": "2.0.0",
  "private": true,
  "description": "UI Language System v2.0 - A comprehensive CSS library with customizable theming",
  "main": "./src/uls-components/src/index.js",
  "module": "./src/uls-components/src/index.js",
  "keywords": [
    "css",
    "design-system",
    "layout",
    "typography",
    "spacing",
    "theming",
    "accessibility",
    "responsive"
  ],
  "author": "ULS Design System Team",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./src/uls-components/src/index.js",
      "require": "./src/uls-components/src/index.js"
    },
    "./styles": {
      "import": "./src/styles/uls-master.less",
      "require": "./src/styles/uls-master.less"
    },
    "./css": {
      "import": "./dist/css/uls.css",
      "require": "./dist/css/uls.css"
    },
    "./dist/css/uls.min.css": {
      "import": "./dist/css/uls.min.css",
      "require": "./dist/css/uls.min.css"
    },
    "./dist/js/passthrough.js": {
      "import": "./dist/js/passthrough.js",
      "require": "./dist/js/passthrough.js"
    },
    "./less": {
      "import": "./src/styles/uls.less",
      "require": "./src/styles/uls.less"
    }
  },
  "workspaces": [
    "src/libs/uls-foundation",
    "src/libs/uls-primereact",
    "src/libs/uls-ember",
    "src/uls-components"
  ],
  "scripts": {
    "uls": "node src/scripts/cli/uls.js",
    "uls-init": "node src/scripts/find-uls.mjs uls.js init",
    "create": "node src/scripts/create-uls-app.js",
    "uls-override": "node src/scripts/init/create-override.js",
    "uls-passthrough": "node src/scripts/init/create-passthrough.js",
    "uls-create-custom-demo": "node src/scripts/components/create-custom-demo.mjs",
    "uls-create-custom-demo-type": "node src/scripts/components/create-custom-demo-type.mjs",
    "uls-sync": "npx uls-sync",
    "create-uls-component": "node src/scripts/components/create-uls-component.js",
    "create-uls-component-demo": "node src/scripts/components/create-uls-component-demo.mjs",
    "create-custom-component-demo": "node src/scripts/components/create-custom-component-demo.mjs",
    "register-uls-component-demo": "node src/scripts/components/register-uls-component-demo.mjs",
    "uls-register-demo": "node src/scripts/components/register-uls-component-demo.mjs",
    "ulsDemo:primereact": "npm --prefix src/libs/uls-primereact run dev",
    "predev": "npm install",
    "ulsBuild": "vite build -c vite.config.build.mjs",
    "ulsDev": "npm run ulsBuild",
    "ulsBuild:css": "vite build -c vite.config.build.mjs -m less",
    "ulsBuild:css:core": "vite build -c vite.config.build.mjs -m less-only",
    "ulsBuild:js": "vite build -c vite.config.build.mjs -m js",
    "ulsDev:watch": "node src/scripts/build/watch-less.mjs",
    "dev": "npm run ulsDev:watch & npm run ulsDemo:primereact",
    "uls-config": "node src/scripts/find-uls.mjs update-config.mjs",
    "uls-update-config": "node src/scripts/find-uls.mjs update-config.mjs"
  },
  "bin": {
    "uls": "src/scripts/cli/uls.js",
    "uls-override": "src/scripts/init/create-override.js",
    "uls-init": "src/scripts/init/create-init.js",
    "uls-watch-less": "src/scripts/build/watch-less.mjs",
    "uls-create-custom-demo": "src/scripts/components/create-custom-demo.mjs",
    "uls-create-custom-demo-type": "src/scripts/components/create-custom-demo-type.mjs",
    "uls-sync": "src/scripts/build/uls-sync.js",
    "uls-register-demo": "src/scripts/components/register-uls-component-demo.mjs",
    "uls-update-config": "src/scripts/init/update-config.mjs",
    "create-custom-component-demo": "src/scripts/components/create-custom-component-demo.mjs"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "esbuild": "^0.23.1",
    "glob": "^13.0.0",
    "inquirer": "^9.2.12",
    "less": "^4.4.2",
    "postcss": "^8.5.6",
    "vite": "^7.3.0"
  },
  "files": [
    "src/styles/uls.less",
    "src/styles/",
    "src/styles/uls-styles/",
    "src/styles/uls-overrides/",
    "dist/",
    "src/scripts/",
    "src/libs/uls-primereact/src/",
    "src/libs/uls-primereact/vite.config.js",
    "src/libs/uls-primereact/package.json",
    "src/libs/uls-primereact/index.html",
    "src/libs/uls-primereact/README.md",
    "src/libs/uls-primereact/eslint.config.js",
    "src/libs/uls-primereact/public/",
    "src/libs/uls-foundation/src/",
    "src/libs/uls-foundation/package.json",
    "src/libs/uls-ember/",
    "src/uls-components/src/",
    "src/uls-components/package.json"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "uls-v2": "git+https://zrepository.zohocorpcloud.in/zohocorp/user/arulkumar.d/ULS_V2.0.git#dev",
    "primereact": "^10.9.7",
    "clsx": "^2.1.1"
  }
}
