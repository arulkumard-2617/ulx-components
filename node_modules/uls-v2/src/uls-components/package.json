{
  "name": "@uls/components",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "React component library built on ULS design system",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "src/",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js"
    },
    "./NewFeature": {
      "import": "./src/components/NewFeature/index.js",
      "require": "./src/components/NewFeature/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.2"
  },
  "keywords": [
    "uls",
    "components",
    "react",
    "design-system",
    "ui-components"
  ],
  "author": "ULS Design System Team",
  "license": "MIT"
}

