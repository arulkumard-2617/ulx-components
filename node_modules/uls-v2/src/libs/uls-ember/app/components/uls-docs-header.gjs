<template>
  <div class="ulsp-topbar h64 pd2 uls-grid col-1 ">
    <header class="uls-container-fluid fxb fvc fsb">
        {{! LEFT: Title }}
        <div class="t-left">
            <div class="t-logo">
                <h3 class="bold-font">ULS 
                    <span class="fg-primary">EMBER</span>
                </h3>
            </div>
        </div>

        {{! RIGHT: Action Buttons }}
        <div class="t-right fxb fvc gp4">
            {{! Search Button }}
            <button type="button" class="uls-button secondary  outlined s-size fxb fvc gp2" aria-haspopup="dialog" aria-expanded="false">
                <span class="fg-text-secondary">Search docs</span>
                <span class="t-key-hint mgl3">⌘ K</span>
            </button>

            {{! Download Button }}
            <button 
                type="button" 
                class="uls-button primary fxb fvc gp2 " 
                aria-haspopup="menu" 
                aria-controls="doc-download-menu">
                 <span>Download ZIP</span>
            </button>

            {{! Theme Toggle Button }}
            
            <button aria-label="Switch to dark theme" class="pd3 uls-button secondary outlined icon-only s-size" data-pc-name="button" data-pc-section="root">
                <i class="uls-icons s18" aria-hidden="true">🌙</i>
                <span class="uls-button-label" data-pc-section="label">&nbsp;</span>
                <span role="presentation" aria-hidden="true" class="uls-button-ink" data-pc-name="ripple" data-pc-section="root" style="height: 40px; width: 40px;"></span>
            </button>
        </div>
    </header>
  </div>
</template>
