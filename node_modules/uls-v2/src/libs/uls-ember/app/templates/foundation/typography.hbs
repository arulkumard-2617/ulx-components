{{page-title "Typography - ULS Ember Documentation"}}

<Common::DocMain::FoundationLayout 
  @title="Typography" 
  @description="Tokenized font scale, heading system, and utility classes."
>
  <div class="uls-foundation-page">
    {{! Font Size Utilities }}
    <Common::DocMain::FoundationSection 
      @id="typography-font-sizes"
      @title="Font Size Utilities"
      @subtitle="Each class compiles to the tokenized REM scale defined in @typography.less."
    >
      <Common::DocMain::ClassPropertyTable @rows={{@model.fontSizeRows}} />
    </Common::DocMain::FoundationSection>

    {{! Font Weight Utilities }}
    <Common::DocMain::FoundationSection 
      @id="typography-font-weights"
      @title="Font Weight Utilities"
      @subtitle="Utility classes switch between Puvi font variants while keeping semantic weights."
    >
      <Common::DocMain::ClassPropertyTable @rows={{@model.fontWeightRows}} />
    </Common::DocMain::FoundationSection>

    {{! Heading Styles }}
    <Common::DocMain::FoundationSection 
      @id="typography-headings"
      @title="Heading Styles"
      @subtitle="Semantic elements and utility aliases share the same design tokens."
    >
      <Common::DocMain::ClassPropertyTable 
        @rows={{@model.headingRows}} 
        @columnLabels={{array "Selector / Class" "Properties"}}
      />
    </Common::DocMain::FoundationSection>
  </div>
</Common::DocMain::FoundationLayout>
