{{page-title "Quick Start - ULX Ember Documentation"}}

<DocShared::DocMain::FoundationLayout
  @title="Quick Start"
  @description="Get ULX installed, load the required stylesheet, and render your first component quickly."
>
  <div class="flex justify-between gap-8 items-start min-w-0">
    <div class="grow w-full min-w-0">
      <DocShared::DocMain::FoundationSection
        @id="quick-start-install-package"
        @title="Install the package"
        @subtitle="Install the ULX package from npm before importing any components."
      >
        <DocShared::DocMain::CodePreview
          @source="npm install ulx-components"
          @language="bash"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="quick-start-load-stylesheet"
        @title="Load the stylesheet"
        @subtitle="Load the built stylesheet so ULX components render with the expected ULS_V2 styles."
      >
        <DocShared::DocMain::CodePreview
          @source="dev-releases/css/ulx-editor.min.css"
          @language="text"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="quick-start-apply-theme-classes"
        @title="Apply theme classes"
        @subtitle="Apply the required root theme classes so colors, tokens, and theme appearance are activated."
      >
        <DocShared::DocMain::CodePreview
          @source='<body class="ulx-default-mode ulx-cardinal-theme">'
          @language="html"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="quick-start-use-your-first-component"
        @title="Use your first component"
        @subtitle="Import a component from the package and render it in your template to confirm the setup is working."
      >
        <DocShared::DocMain::CodePreview
          @source="import { UlxButton } from 'ulx-components';

<template>
  <UlxButton @label='Save' @variant='primary' />
</template>"
          @language="gjs"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="quick-start-installation"
        @title="Installation"
      >
        <p class="mt-0 mb-5 fg-text-secondary text-16">
          {{"Install the package from npm, import the components you need from <code>ulx-components</code>, load the built stylesheet from <code>dev-releases</code>, and apply the required theme classes on the page root.<br /><br />If the stylesheet is missing, components may render functionally but will not look correct."}}
        </p>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="quick-start-component-imports"
        @title="Component imports"
        @subtitle="Import the components you need directly from the package entry point."
      >
        <DocShared::DocMain::CodePreview
          @source="import { UlxButton, UlxInput, UlxDropdown } from 'ulx-components';"
          @language="gjs"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="quick-start-theme-setup"
        @title="Theme setup"
        @subtitle="Use the correct root theme classes so the component library picks up the expected visual theme."
      >
        <DocShared::DocMain::CodePreview
          @source='<body class="ulx-default-mode ulx-cardinal-theme">'
          @language="html"
        />
      </DocShared::DocMain::FoundationSection>
    </div>
    <DocShared::DocMain::DocSectionNav @features={{@model.sections}} />
  </div>
</DocShared::DocMain::FoundationLayout>