{{page-title "Styles and Theming - ULX Ember Documentation"}}

<DocShared::DocMain::FoundationLayout
  @title="Styles and Theming"
  @description="Learn how ULX uses ULS_V2 styles, how themes are applied, and where overrides should live."
>
  <div class="flex justify-between gap-8 items-start min-w-0">
    <div class="grow w-full min-w-0">
      <DocShared::DocMain::FoundationSection
        @id="styles-and-theming-foundation"
        @title="Foundation"
      >
        <p class="mt-0 mb-5 fg-text-secondary text-16">
          {{"ULX is not a standalone styling system. It is built to work on top of ULS_V2 and reuse its class contracts, utilities, themes, and visual patterns."}}
        </p>
        <p class="mt-0 mb-0 text-16">
          {{"ULX provides Ember component behavior and public APIs, while ULS_V2 provides the underlying visual language. That relationship is what keeps the system consistent across apps."}}
        </p>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="styles-and-theming-themes"
        @title="Themes and root classes"
      >
        <p class="mt-0 mb-5 fg-text-secondary text-16">
          {{"Theme classes are applied on the page root, commonly on <code>body</code>. Without the correct root classes, colors, tokens, and theme-specific appearance may not match expected ULX output."}}
        </p>
        <DocShared::DocMain::CodePreview
          @source='<body class="ulx-default-mode ulx-cardinal-theme">'
          @language="html"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="styles-and-theming-overrides"
        @title="Overrides and order"
      >
        <div class="ulx-grid col-1 gap-4 mt-4">
          <div class="flex items-center gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              {{"Do not modify core styles directly; use the intended override layer."}}
            </p>
          </div>
          <div class="flex items-center gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              {{"Keep import and override order predictable so base styles load before customizations."}}
            </p>
          </div>
          <div class="flex items-center gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              {{"Prefer system-level alignment over one-off app-specific hacks whenever possible."}}
            </p>
          </div>
        </div>
      </DocShared::DocMain::FoundationSection>
    </div>
    <DocShared::DocMain::DocSectionNav @features={{@model.sections}} />
  </div>
</DocShared::DocMain::FoundationLayout>