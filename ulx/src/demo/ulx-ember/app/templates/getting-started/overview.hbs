{{page-title "Overview - ULX Ember Documentation"}}

<DocShared::DocMain::FoundationLayout
  @title="Overview"
  @description="Understand what ULX is, how it relates to ULS_V2, and who should start here first."
>
  <div class="flex justify-between gap-8 items-start min-w-0">
    <div class="grow w-full min-w-0">
      <DocShared::DocMain::FoundationSection
        @id="overview-introduction"
        @title="Introduction"
      >
        <p class="mt-0 mb-5 fg-text-secondary text-16">
          {{"ULX is a component library built on top of ULS_V2, our design system."}}
        </p>
        <p class="mt-0 mb-0 fg-text-secondary text-16">
          {{"ULS_V2 provides the visual foundation such as styles, themes, utilities, and shared design patterns. ULX builds on top of that foundation and exposes Ember components that teams can use directly in applications."}}
        </p>
        <div class="mt-6">
          <UlxMessage @variant="info" @icon="info-icon">
            <div class="flex flex-col gap-1">
              <span>{{"Need deeper internal guidance for docs authoring, demo pages, or variations?"}}</span>
              <LinkTo
                @route="getting-started.docs-walkthrough"
                class="ulx-button link text-button flex justify-start"
              >
                {{"Use the Docs Walkthrough page."}}
              </LinkTo>

            </div>
          </UlxMessage>
        </div>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="overview-advantages"
        @title="Advantages of ULX"
      >
        <div class="ulx-grid col-1 gap-4 mt-4">
          <div class="flex items-start gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              <span class="bold-font">{{"Reusable Components"}}:</span>
              {{"Teams can use shared Ember components instead of rebuilding the same interface patterns in every app."}}
            </p>
          </div>
          <div class="flex items-start gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              <span class="bold-font">{{"Consistency"}}:</span>
              {{"ULX stays aligned with ULS_V2 styles, themes, and design decisions so product UI remains visually consistent."}}
            </p>
          </div>
          <div class="flex items-start gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              <span class="bold-font">{{"Maintainability"}}:</span>
              {{"Updates are easier to manage because common behavior and shared styling live in one system instead of many app-specific implementations."}}
            </p>
          </div>
          <div class="flex items-start gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              <span class="bold-font">{{"Faster Development"}}:</span>
              {{"Teams can move faster with ready-to-use building blocks for forms, navigation, overlays, data display, and feedback patterns."}}
            </p>
          </div>
          <div class="flex items-start gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              <span class="bold-font">{{"Shared foundation"}}:</span>
              {{"ULX combines Ember component APIs with the ULS_V2 design foundation, making the system easier to adopt across products."}}
            </p>
          </div>
        </div>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="overview-who-is-this-for"
        @title="Who is this for"
      >
        <p class="mt-0 mb-5 fg-text-secondary text-16">
          {{"The overview page is intended to help both product consumers and internal team members understand where ULX fits and when to use it."}}
        </p>
        <div class="ulx-grid col-1 gap-4">
          <div class="flex items-start gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              <span class="bold-font">{{"Application Developers"}}:</span>
              {{"This path is for developers who want to install ULX, load the required styles, and start using components in their applications."}}
            </p>
          </div>
          <div class="flex items-start gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              <span class="bold-font">{{"New Team Members"}}:</span>
              {{"This page also helps new team members understand how ULX depends on ULS_V2 and how the design system is applied in practice."}}
            </p>
          </div>
        </div>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="overview-next-steps"
        @title="Explore next"
      >
        <div class="ulx-grid col-2 col-sm-1 gap-4">
          <LinkTo
            @route="getting-started.quick-start"
            class="block decoration-none fg-text"
          >
            <UlxCard
              @title="Quick Start"
              @subTitle="Installation"
              @appearance="outlined"
              @interactive={{true}}
              @hoverable={{true}}
              @rounded={{true}}
              @customClass="h-full"
              @contentClass="flex-1 bg-layer1"
            >
              <p class="fg-text-secondary text-14 mb-0">
                {{"Set up ULX quickly, load the required stylesheet, and render your first component."}}
              </p>
            </UlxCard>
          </LinkTo>

          <LinkTo
            @route="getting-started.styles-and-theming"
            class="block decoration-none fg-text"
          >
            <UlxCard
              @title="Styles and Theming"
              @subTitle="Themes and root classes"
              @appearance="outlined"
              @interactive={{true}}
              @hoverable={{true}}
              @rounded={{true}}
              @customClass="h-full"
              @contentClass="flex-1 bg-layer1"
            >
              <p class="fg-text-secondary text-14 mb-0">
                {{"Understand how ULX builds on ULS_V2 styles, themes, and overrides."}}
              </p>
            </UlxCard>
          </LinkTo>

          <LinkTo
            @route="getting-started.docs-walkthrough"
            class="block decoration-none fg-text"
          >
            <UlxCard
              @title="Docs Walkthrough"
              @subTitle="Next steps"
              @appearance="outlined"
              @interactive={{true}}
              @hoverable={{true}}
              @rounded={{true}}
              @customClass="h-full"
              @contentClass="flex-1 bg-layer1"
            >
              <p class="fg-text-secondary text-14 mb-0">
                {{"Open the internal guide for demo-page authoring, docs updates, and variations."}}
              </p>
            </UlxCard>
          </LinkTo>

          <LinkTo
            @route="components.button"
            class="block decoration-none fg-text"
          >
            <UlxCard
              @title="Components"
              @subTitle="Button"
              @appearance="outlined"
              @interactive={{true}}
              @hoverable={{true}}
              @rounded={{true}}
              @customClass="h-full"
              @contentClass="flex-1 bg-layer1"
            >
              <p class="fg-text-secondary text-14 mb-0">
                {{"Jump into the component docs and start exploring the available ULX building blocks."}}
              </p>
            </UlxCard>
          </LinkTo>
        </div>
      </DocShared::DocMain::FoundationSection>
    </div>
    <DocShared::DocMain::DocSectionNav @features={{@model.sections}} />
  </div>
</DocShared::DocMain::FoundationLayout>