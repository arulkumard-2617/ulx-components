{{page-title "AI Guide - ULX Ember Documentation"}}

<DocShared::DocMain::FoundationLayout
  @title="AI guide"
  @description="How to use this documentation site when teaching AI assistants with a shared demo URL."
>
  <div class="flex justify-between gap-8 items-start min-w-0">
    <div class="grow w-full min-w-0">
      <DocShared::DocMain::FoundationSection
        @id="ai-guide-purpose"
        @title="Purpose"
      >
        <p class="mt-0 mb-0 fg-text-secondary text-16">
          {{"This site is the primary reference when teams paste a component URL into an AI chat. Each component page is structured so the default Features tab contains decision guidance (Usages), common arguments, imports, and working examples—without relying on hidden tabs."}}
        </p>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="ai-guide-read-order"
        @title="How to read a component page"
      >
        <ol class="mgt0 mb-0 pl-5 text-16">
          <li class="mb-2">
            <strong>Usage guidance</strong>
            {{" — expand for when/how to use, do/don't, and anti-patterns"}}
          </li>
          <li class="mb-2">
            <strong>API arguments</strong>
            {{" — separate accordion with the full generated API table"}}
          </li>
          <li class="mb-0">
            <strong>Import and Basic</strong>
            {{" — live demo and snippets below the guidance accordions"}}
          </li>
        </ol>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="ai-guide-urls"
        @title="URLs and static JSON"
      >
        <p class="mt-0 mb-4 fg-text-secondary text-16">
          {{"The demo app is a client-rendered SPA. Browser-based tools see the full Features page. Fetchers that do not run JavaScript should use static JSON instead:"}}
        </p>
        <ul class="mgt0 mb-0 pl-5 text-16">
          <li class="mb-2">
            <code>/llms.txt</code>
            {{" — site map for AI discovery"}}
          </li>
          <li class="mb-2">
            <code>/ai/manifest.json</code>
            {{" — catalog of components with usages"}}
          </li>
          <li class="mb-0">
            <code>/ai/components/{slug}.json</code>
            {{" — per-component usages and metadata"}}
          </li>
        </ul>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="ai-guide-families"
        @title="Component families"
      >
        <p class="mt-0 mb-4 text-16">
          <strong>Overlays:</strong>
          {{" UlxPopup (anchored panel), UlxModal (blocking dialog), UlxSlidePane (edge drawer), UlxTooltip (hint). Read Usages on each before substituting one for another."}}
        </p>
        <p class="mt-0 mb-4 text-16">
          <strong>Buttons:</strong>
          {{" UlxButton (labeled actions), UlxIconButton (icon-first), UlxSplitButton (action + menu), UlxBadgeButton (badge-style toggle)."}}
        </p>
        <p class="mt-0 mb-0 text-16">
          <strong>Selection:</strong>
          {{" UlxDropdown, UlxMultiSelect, UlxOptionSegment, UlxSelectButton — compare Usages sections for single vs multi vs segmented selection."}}
        </p>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="ai-guide-prompt"
        @title="Example prompt"
      >
        <DocShared::DocMain::CodePreview
          @source="Read /components/icon-button on the ULX demo: Usages, Key arguments, Import, and IconOnly. Implement UlxIconButton with aria-label for icon-only. Use variant danger only for destructive actions."
          @language="text"
        />
      </DocShared::DocMain::FoundationSection>
    </div>
    <DocShared::DocMain::DocSectionNav @features={{@model.sections}} />
  </div>
</DocShared::DocMain::FoundationLayout>
