{{page-title "Common Mistakes - ULX Ember Documentation"}}

<DocShared::DocMain::FoundationLayout
  @title="Common mistakes"
  @description="Avoid the most common setup issues that make ULX appear broken or inconsistent."
>
  <div class="flex justify-between gap-8 items-start min-w-0">
    <div class="grow w-full min-w-0">
      <DocShared::DocMain::FoundationSection
        @id="common-mistakes-list"
        @title="Common mistakes"
      >
        <p class="mt-0 mb-5 fg-text-secondary text-16">
          {{"Most early issues with ULX are setup issues rather than component issues."}}
        </p>
        <div class="ulx-grid col-1 gap-4 mt-4">
          <div class="flex items-center gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              {{"Using ULX components without loading the stylesheet."}}
            </p>
          </div>
          <div class="flex items-center gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              {{"Using the wrong stylesheet filename or path."}}
            </p>
          </div>
          <div class="flex items-center gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              {{"Forgetting to apply the required theme classes on the page root."}}
            </p>
          </div>
          <div class="flex items-center gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              {{"Treating ULX as independent from ULS_V2 when styling or customizing."}}
            </p>
          </div>
          <div class="flex items-center gap-1">
            <UlxIcon
              @customClass="fg-green"
              @type="font"
              @iconName="ls-tick-filled-icon"
              @size="s28"
              aria-hidden="true"
            />
            <p class="mt-0 mb-0 text-16">
              {{"Adding custom overrides before confirming that the base ULX setup is correct."}}
            </p>
          </div>
        </div>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="common-mistakes-correct-stylesheet-path"
        @title="Correct stylesheet path"
        @subtitle="Load the built stylesheet so ULX components render with the expected ULS_V2 styles."
      >
        <DocShared::DocMain::CodePreview
          @source="dev-releases/css/ulx-editor.min.css"
          @language="text"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="common-mistakes-required-theme-classes"
        @title="Required theme classes"
        @subtitle="Apply the required root theme classes so colors, tokens, and theme appearance are activated."
      >
        <DocShared::DocMain::CodePreview
          @source='<body class="ulx-default-mode ulx-cardinal-theme">'
          @language="html"
        />
      </DocShared::DocMain::FoundationSection>
    </div>
    <DocShared::DocMain::DocSectionNav @features={{@model.sections}} />
  </div>
</DocShared::DocMain::FoundationLayout>