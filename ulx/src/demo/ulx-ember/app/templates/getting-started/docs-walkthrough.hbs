{{page-title "Docs Walkthrough - ULX Ember Documentation"}}

<DocShared::DocMain::FoundationLayout
  @title="Docs Walkthrough"
  @description="Internal guide for running the docs app and scaffolding demo pages and variations."
>
  <div class="flex justify-between gap-8 items-start min-w-0">
    <div class="grow w-full min-w-0">
      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-prerequisites"
        @title="Prerequisites"
      >
        <div
          class="mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content="Ensure you have <code>Node.js</code> (with npm) and <code>Git</code> installed. All create, destroy, and variation commands below must be run from the <code>ulx</code> project root, where the related scripts are defined."
          />
        </div>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-run-docs"
        @title="Run the documentation"
      >
        <div
          class="mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content="From the <code>ulx-ember</code> demo app directory, run the dev server to view the docs and your new pages locally."
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run start"
          @language="bash"
        />
        <div
          class="mt-4 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content="Then open <code>localhost:4200</code>. New demo pages and variations appear under the relevant sidebar section."
          />
        </div>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-create-demo-page"
        @title="Create demo-page"
      >
        <div
          class="mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content="Scaffold a new demo page for a component. Use <code>--category</code> (for example: collections, elements, or modules) and optionally <code>--submodule</code> to match your docs structure."
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run create -- demo-page 'PageName[PageName]' --category elements --submodule form"
          @language="bash"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-delete-demo-page"
        @title="Delete demo-page"
      >
        <div
          class="mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content="Remove an existing demo page. Use the same <code>--category</code> value that was used when the page was created."
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run destroy demo-page PageName --category collections"
          @language="bash"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-create-variations"
        @title="Create variations"
      >
        <div
          class="mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content="Add a new variation such as Default, Controlled, or Disabled to a component demo. Pass both <code>--component</code> and <code>--variation</code>. The leading <code>--</code> forwards args to the underlying script."
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run add-variation -- --component=PageName --variation=VariationName"
          @language="bash"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-delete-variations"
        @title="Delete variations"
      >
        <div
          class="mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content="Remove a specific variation from a component. Use this when a demo state is no longer needed or has been renamed."
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run destroy-variation -- --component=ComponentName --variation=VariationName"
          @language="bash"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-next-steps"
        @title="Next steps"
      >
        <div
          class="mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content="Use the sidebar to verify where your new documentation appears, then continue refining demos, snippets, and related documentation files as needed."
          />
        </div>
      </DocShared::DocMain::FoundationSection>
    </div>
    <DocShared::DocMain::DocSectionNav @features={{@model.sections}} />
  </div>
</DocShared::DocMain::FoundationLayout>