{{page-title "Docs Walkthrough - ULX Ember Documentation"}}

<DocShared::DocMain::FoundationLayout
  @title={{t "lbl.docs.walkthrough"}}
  @description={{t "msg.docs.walkthrough.description"}}
>
  <div class="doc-panel-wrapper flex justify-between">
    <div class="doc-panel grow w-full">
      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-prerequisites"
        @title={{t "lbl.prerequisites"}}
      >
        <div
          class="ulx-foundation-section__subtitle mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content={{t "msg.docs.walkthrough.prerequisites"}}
          />
        </div>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-run-docs"
        @title={{t "msg.run.the.documentation"}}
      >
        <div
          class="ulx-foundation-section__subtitle mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content={{t "msg.docs.walkthrough.run.documentation"}}
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run start"
          @language="bash"
        />
        <div
          class="ulx-foundation-section__subtitle mt-4 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content={{t "msg.docs.walkthrough.run.documentation.followup"}}
          />
        </div>
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-create-demo-page"
        @title={{t "lbl.create.demo.page"}}
      >
        <div
          class="ulx-foundation-section__subtitle mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content={{t "msg.docs.walkthrough.create.demo.page"}}
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run create -- demo-page 'PageName[PageName]' --category elements --submodule form"
          @language="bash"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-delete-demo-page"
        @title={{t "lbl.delete.demo.page"}}
      >
        <div
          class="ulx-foundation-section__subtitle mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content={{t "msg.docs.walkthrough.delete.demo.page"}}
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run destroy demo-page PageName --category collections"
          @language="bash"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-create-variations"
        @title={{t "lbl.create.variations"}}
      >
        <div
          class="ulx-foundation-section__subtitle mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content={{t "msg.docs.walkthrough.create.variations"}}
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run add-variation -- --component=PageName --variation=VariationName"
          @language="bash"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-delete-variations"
        @title={{t "lbl.delete.variations"}}
      >
        <div
          class="ulx-foundation-section__subtitle mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content={{t "msg.docs.walkthrough.delete.variations"}}
          />
        </div>
        <DocShared::DocMain::CodePreview
          @source="npm run destroy-variation -- --component=ComponentName --variation=VariationName"
          @language="bash"
        />
      </DocShared::DocMain::FoundationSection>

      <DocShared::DocMain::FoundationSection
        @id="docs-walkthrough-next-steps"
        @title={{t "lbl.next.steps"}}
      >
        <div
          class="ulx-foundation-section__subtitle mb-5 font-regular fg-text-secondary me-0"
        >
          <DocShared::DocMain::RichText
            @as="span"
            @content={{t "msg.docs.walkthrough.next.steps"}}
          />
        </div>
      </DocShared::DocMain::FoundationSection>
    </div>
    <DocShared::DocMain::DocSectionNav @features={{@model.sections}} />
  </div>
</DocShared::DocMain::FoundationLayout>
