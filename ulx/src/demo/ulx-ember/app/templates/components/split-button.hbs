{{page-title "SplitButton - ULS Ember Documentation"}}

<DocShared::DocMain::ComponentLayout
  @title={{@model.meta.header}}
  @description={{@model.meta.subHeader}}
  @tabs={{this.tabs}}
  @activeTab={{this.activeTab}}
  @onTabChange={{this.onTabChange}}
>
  {{#if this.isFeaturesTab}}
    <DocShared::DocMain::DocPanel @features={{@model.features}} />
  {{else if this.isThemingTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-collections-split-button-theming"
        @title={{t "lbl.theming"}}
        @subtitle={{t "msg.theming.subtitle" component="SplitButton"}}
      >
        <p class="fg-text-secondary">SplitButton uses ULS split-button and
          button class names from uls-v2 collections/split-button.less.</p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{else if this.isPassthroughTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-collections-split-button-passthrough"
        @title={{t "lbl.pass.through"}}
        @subtitle={{t "msg.pass.through.subtitle" component="SplitButton"}}
      >
        <p class="fg-text-secondary">{{t "msg.pass.through.content.goes.here"}}</p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{/if}}
</DocShared::DocMain::ComponentLayout>
