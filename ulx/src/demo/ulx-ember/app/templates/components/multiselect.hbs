{{page-title (t "lbl.doc.multiselect.title")}}

<DocShared::DocMain::ComponentLayout
  @title={{@model.meta.header}}
  @description={{@model.meta.subHeader}}
  @tabs={{this.tabs}}
  @activeTab={{this.activeTab}}
  @onTabChange={{this.onTabChange}}
>
  {{#if this.isFeaturesTab}}
    <DocShared::DocMain::DocPanel @features={{@model.features}} />
  {{else if this.isThemingTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-collections-multiselect-theming"
        @title={{t "lbl.theming"}}
        @subtitle={{t "msg.theming.subtitle" component="MultiSelect"}}
      >
        <p class="fg-text-secondary">{{t "msg.theming.content.goes.here"}}</p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{else if this.isBuilderTab}}
    <DocShared::DocMain::ComponentBuilder @schema={{@model.builderSchema}}>
      <:preview as |props|>
        <div class="ulx-form s-size ulx-grid gap-12">
          <UlxField
            @label={{props.fieldLabel}}
            @fieldClass={{props.fieldClass}}
            @helpText={{props.fieldHelpText}}
            @error={{props.fieldError}}
            @fieldId="multiselect-doc-builder"
            as |field|
          >
            <UlxMultiSelect
              @field={{field}}
              @options={{props.options}}
              @placeholder={{props.placeholder}}
              @display={{props.display}}
              @showClear={{props.showClear}}
              @filter={{props.filter}}
              @selectAll={{props.selectAll}}
              @disabled={{props.disabled}}
              @invalid={{props.invalid}}
            />
          </UlxField>
        </div>
      </:preview>
    </DocShared::DocMain::ComponentBuilder>
  {{else if this.isPassthroughTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-collections-multiselect-passthrough"
        @title={{t "lbl.pass.through"}}
        @subtitle={{t "msg.pass.through.subtitle" component="MultiSelect"}}
      >
        <p class="fg-text-secondary">{{t
            "msg.pass.through.content.goes.here"
          }}</p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{/if}}
</DocShared::DocMain::ComponentLayout>