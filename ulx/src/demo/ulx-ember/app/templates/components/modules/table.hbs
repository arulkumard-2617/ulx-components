{{page-title "Table - ULS Ember Documentation"}}

<Common::DocMain::ComponentLayout
  @title={{@model.meta.header}}
  @description={{@model.meta.subHeader}}
  @tabs={{this.tabs}}
  @activeTab={{this.activeTab}}
  @onTabChange={{this.onTabChange}}
>
  {{#if this.isFeaturesTab}}
    <Common::DocMain::DocPanel @features={{@model.features}} />
  {{else if this.isThemingTab}}
    <div class="doc-section">
      <Common::DocMain::FoundationSection
        @id="components-modules-table-theming"
        @title="Theming"
        @subtitle="Theming documentation for the UlxTable component."
      >
        <p class="fg-text-secondary">
          UlxTable uses CSS classes from <code>ULS_V2.0/src/styles/uls-styles/less/modules/table.less</code>.
          The root class is <code>ulx-datatable</code>. All child elements use unprefixed classes scoped under the root.
        </p>
      </Common::DocMain::FoundationSection>
    </div>
  {{else if this.isPassthroughTab}}
    <div class="doc-section">
      <Common::DocMain::FoundationSection
        @id="components-modules-table-passthrough"
        @title="Pass Through"
        @subtitle="Pass Through props for UlxTable."
      >
        <p class="fg-text-secondary">Pass additional HTML attributes via <code>...attributes</code> on the root element.</p>
      </Common::DocMain::FoundationSection>
    </div>
  {{/if}}
</Common::DocMain::ComponentLayout>
