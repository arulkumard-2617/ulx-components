{{page-title "Dropdown - ULS Ember Documentation"}}

<DocShared::DocMain::ComponentLayout
  @title={{@model.meta.header}}
  @description={{@model.meta.subHeader}}
  @tabs={{this.tabs}}
  @activeTab={{this.activeTab}}
  @onTabChange={{this.onTabChange}}
>
  {{#if this.isFeaturesTab}}
    <DocShared::DocMain::DocPanel @features={{@model.features}} />
  {{else if this.isThemingTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-elements-dropdown-theming"
        @title="Theming"
        @subtitle="Theming documentation for Dropdown component."
      >
        <p class="fg-text-secondary">{{"Theming content goes here."}}</p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{else if this.isBuilderTab}}
    <DocShared::DocMain::ComponentBuilder @schema={{@model.builderSchema}}>
      <:preview as |props|>
        <div class="ulx-form s-size ulx-grid gap-12">
          <UlxField
            @label={{props.label}}
            @fieldClass={{props.fieldClass}}
            @helpText={{props.helpText}}
            @error={{props.error}}
            @key="doc-builder-dropdown"
          >
            <:default as |field|>
              <UlxDropdown
                @key={{field.key}}
                @ariaDescribedBy={{field.describedBy}}
                @ariaErrorMessage={{field.errorId}}
                @options={{props.options}}
                @placeholder={{props.placeholder}}
                @showClear={{props.showClear}}
                @filter={{props.filter}}
                @disabled={{props.disabled}}
                @invalid={{props.invalid}}
              />
            </:default>
          </UlxField>
        </div>
      </:preview>
    </DocShared::DocMain::ComponentBuilder>
  {{else if this.isPassthroughTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-elements-dropdown-passthrough"
        @title="Pass Through"
        @subtitle="Pass Through props documentation for Dropdown component."
      >
        <p class="fg-text-secondary">{{"Pass Through content goes here."}}</p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{/if}}
</DocShared::DocMain::ComponentLayout>
