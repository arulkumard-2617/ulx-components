{{page-title "Button - ULS Ember Documentation"}}

<DocShared::DocMain::ComponentLayout
  @title={{@model.meta.header}}
  @description={{@model.meta.subHeader}}
  @tabs={{this.tabs}}
  @activeTab={{this.activeTab}}
  @onTabChange={{this.onTabChange}}
>
  {{#if this.isFeaturesTab}}
    <DocShared::DocMain::DocPanel @features={{@model.features}} />
  {{else if this.isThemingTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-elements-button-theming"
        @title="Theming"
        @subtitle="Theming documentation for Button component."
      >
        <p class="fg-text-secondary">Button component theming uses ULS class
          names (uls-button, uls-button-primary, etc.) which can be styled via
          the ULS design system.</p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{/if}}
</DocShared::DocMain::ComponentLayout>