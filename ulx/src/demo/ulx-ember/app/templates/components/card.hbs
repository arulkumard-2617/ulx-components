{{page-title "Card - ULS Ember Documentation"}}

<DocShared::DocMain::ComponentLayout
  @title={{@model.meta.header}}
  @description={{@model.meta.subHeader}}
  @tabs={{this.tabs}}
  @activeTab={{this.activeTab}}
  @onTabChange={{this.onTabChange}}
>
  {{#if this.isFeaturesTab}}
    <DocShared::DocMain::DocPanel @features={{@model.features}} />
  {{else if this.isThemingTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-collections-card-theming"
        @title="Theming"
        @subtitle="Theming documentation for Card component."
      >
        <p class="fg-text-secondary">
          Card uses ULS_V2.0 card classes (ulx-card, ulx-card-header, ulx-card-title,
          ulx-card-subtitle, ulx-card-content, ulx-card-footer) from card.less.
        </p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{else if this.isPassthroughTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-collections-card-passthrough"
        @title="Pass Through"
        @subtitle="Pass Through props documentation for Card component."
      >
        <p class="fg-text-secondary">
          {{"Pass Through content goes here."}}
        </p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{/if}}
</DocShared::DocMain::ComponentLayout>

