{{page-title "ProgressSpinner - ULS Ember Documentation"}}

<DocShared::DocMain::ComponentLayout
  @title={{@model.meta.header}}
  @description={{@model.meta.subHeader}}
  @tabs={{this.tabs}}
  @activeTab={{this.activeTab}}
  @onTabChange={{this.onTabChange}}
>
  {{#if this.isFeaturesTab}}
    <DocShared::DocMain::DocPanel @features={{@model.features}} />
  {{else if this.isThemingTab}}
    <div class="doc-section">
      <DocShared::DocMain::FoundationSection
        @id="components-elements-progressspinner-theming"
        @title={{t "lbl.theming"}}
        @subtitle={{t "msg.theming.subtitle" component="ProgressSpinner"}}
      >
        <p class="fg-text-secondary">ProgressSpinner uses ULS_V2.0
          progress-spinner classes (ulx-progressspinner,
          ulx-progressspinner-svg, ulx-progressspinner-circle) from
          progress-spinner.less.</p>
      </DocShared::DocMain::FoundationSection>
    </div>
  {{else if this.isBuilderTab}}
    <DocShared::DocMain::ComponentBuilder @schema={{@model.builderSchema}}>
      <:preview as |props|>
        <UlxProgressSpinner
          @size={{props.size}}
          @ariaLabel={{props.ariaLabel}}
          @customClass={{props.customClass}}
        />
      </:preview>
    </DocShared::DocMain::ComponentBuilder>
  {{/if}}
</DocShared::DocMain::ComponentLayout>